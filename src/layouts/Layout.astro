---
import '../styles/global.css';
interface Props {
	title: string;
}

const { title } = Astro.props;

---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="DataShield Chile - Gestión de Cumplimiento de Privacidad" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title} | DataShield Chile</title>
	</head>
	<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col font-sans">
		
		<!-- Navbar Principal -->
		<header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
				<div class="flex items-center gap-2">
					<div class="w-8 h-8 bg-indigo-600 rounded-lg flex items-center justify-center text-white font-bold text-lg shadow-md shadow-indigo-200">
						🛡️
					</div>
					<span class="text-xl font-bold tracking-tight text-slate-800">
						DataShield <span class="text-indigo-600 font-medium text-base">Chile</span>
					</span>
				</div>
				<nav class="flex items-center gap-6">
					<a href="/" class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors">Inicio (Captura)</a>
					<a href="/transparencia" class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors">Portal ARCO</a>
					<a href="/politicas" class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors">Gestión de Políticas</a>
					<a href="/dashboard" class="text-sm font-medium text-slate-600 hover:text-indigo-600 transition-colors bg-slate-100 hover:bg-indigo-50 px-3 py-1.5 rounded-md border border-slate-200 hover:border-indigo-200">Panel Interno</a>
				</nav>
			</div>
		</header>

		<!-- Contenido Principal Dinámico -->
		<main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
			<slot />
		</main>

		<!-- Footer de Cumplimiento -->
		<footer class="bg-white border-t border-slate-200 py-6 mt-12 text-center text-xs text-slate-500">
			<p>&copy; {new Date().getFullYear()} DataShield. Infraestructura trazable adaptada a regulaciones de privacidad.</p>
		</footer>

	</body>
</html>